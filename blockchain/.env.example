# Sepolia Testnet Configuration (Optional - only required if deploying to Sepolia)
# Replace with your Infura/Alchemy/QuickNode RPC endpoint:
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# 32-byte Private Key of the deployer wallet (must have Sepolia faucet ETH):
# WARNING: NEVER commit your actual private key or fund it with real mainnet assets!
DEPLOYER_PRIVATE_KEY=your_sepolia_deployer_private_key_without_quotes
