# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Update this to your local MongoDB URI or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/secure-medical-records

# Authentication
JWT_SECRET=super_secret_jwt_key_for_development
JWT_EXPIRE=30d

# Blockchain Configuration (Hardhat Local Network)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
SMART_CONTRACT_ADDRESS=your_deployed_contract_address_here
SYSTEM_WALLET_PRIVATE_KEY=your_hardhat_test_account_private_key_here
