PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/secure-medical-records
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h

# Blockchain Network Configuration
# Set to 'hardhat' for local development (default), or 'sepolia' for Ethereum Sepolia testnet
CHAIN_NETWORK=hardhat

# Local Hardhat (used when CHAIN_NETWORK=hardhat)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
SYSTEM_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia Testnet (required when CHAIN_NETWORK=sepolia)
# Replace with your actual RPC endpoint and testnet deployer private key in server/.env
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
DEPLOYER_PRIVATE_KEY=your_sepolia_private_key_here

# Scheduled Integrity Audit Cron Expression (Default: 02:00 daily)
AUDIT_CRON=0 2 * * *
